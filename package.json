{
  "name": "codex-discord-voice-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Discord voice bridge planning core for Codex",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@discordjs/opus": "0.10.0"
  },
  "overrides": {
    "tar": "7.5.22"
  },
  "scripts": {
    "dry-run": "node src/cli.ts dry-run --config config/bridge.example.json",
    "dry-run:discord": "node src/cli.ts dry-run --transport discord --config config/bridge.example.json",
    "dry-run:meet": "node src/cli.ts dry-run --transport meet --config config/bridge.example.json",
    "preflight:discord": "node src/preflight-cli.ts",
    "smoke:voice": "node src/discord-gateway-smoke.ts",
    "live:meetron:windows": "node scripts/run-meetron-windows-live.mjs",
    "live:meetron:macos": "node scripts/run-meetron-macos-live.mjs",
    "build:coreaudio:macos": "swift build -c release --package-path native/macos",
    "build:relay:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-discodex-relay.ps1",
    "build:relay:macos": "zsh scripts/build-discodex-relay-macos.sh",
    "test:acceptance": "node --test tests/product-acceptance.test.ts",
    "test": "node --test tests/*.test.ts tests/*.test.mjs"
  }
}
